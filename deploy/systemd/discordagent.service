[Unit]
Description=Discord Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordagent
Group=discordagent
EnvironmentFile=/etc/discordagent/discordagent.env
WorkingDirectory=/opt/discordagent/current
RuntimeDirectory=discordagent
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/node /opt/discordagent/current/dist/smoke/hostPreflight.js
ExecStartPre=/usr/bin/node /opt/discordagent/current/dist/smoke/resourceAdmission.js
ExecStart=/usr/bin/flock --nonblock /run/discordagent/instance.lock /usr/bin/node /opt/discordagent/current/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/discordagent /var/lib/discordagent/repos /var/lib/discordagent/worktrees
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
