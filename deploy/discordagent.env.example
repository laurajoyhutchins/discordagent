NODE_ENV=production
HOME=/var/lib/discordagent

DISCORD_TOKEN=replace-with-discord-token
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_GUILD_ID=replace-with-discord-guild-id
AUTHORIZED_ROLE_IDS=replace-with-authorized-role-id
AUTHORIZED_USER_ID=replace-with-owner-user-id

APP_DATA_DIR=/var/lib/discordagent
DATABASE_PATH=/var/lib/discordagent/discordagent.sqlite
PROJECTS_BASE_DIR=/var/lib/discordagent/repos
WORKTREES_BASE_DIR=/var/lib/discordagent/worktrees

CLAUDE_ENABLED=false
CODEX_ENABLED=true
OPENCODE_ENABLED=false
REQUIRED_PROVIDERS=codex

HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
MAX_CONCURRENT_TASKS=1
MIN_FREE_DISK_MB=2048
PRIMARY_USAGE_RESERVE=10
